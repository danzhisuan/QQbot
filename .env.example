# ============================================================
# 使用方式：cp .env.example .env   然后修改下面的值
# 改完后执行：docker compose up -d --build nonebot
#
# 本模板对应当前实际部署：NapCat 与 NoneBot 都在服务器上，
# 由 docker-compose 编排，通过 Docker 内网互连。
# ============================================================

# ---------- NoneBot 运行时 ----------
DRIVER=~fastapi

# 这两个值只影响「不用容器、直接在宿主机跑」的场景。
# 容器化部署时，docker-compose.yml 会覆盖为 HOST=0.0.0.0 / PORT=8080，
# 且该端口不映射到宿主机，公网访问不到。
# 注意宿主机 8080 已被 nginx 占用，所以本地直跑时用 18080。
HOST=127.0.0.1
PORT=18080
LOG_LEVEL=INFO

# 管理员 QQ 号，拥有 SUPERUSER 权限（JSON 数组格式）
SUPERUSERS=["10001"]

# 命令前缀。默认只认 "/"；想要「无前缀」命令改成 ["/", ""]，但群里容易误触发
COMMAND_START=["/"]

# OneBot 鉴权 Token：必须与 NapCat 侧配置完全一致
# 生成方式：openssl rand -hex 32
ONEBOT_ACCESS_TOKEN=CHANGE_ME_USE_openssl_rand_hex_32

# ---------- NapCat 容器 ----------
# 宿主机用户 uid/gid，决定挂载目录属主。服务器上执行 id -u / id -g 获取
NAPCAT_UID=1001
NAPCAT_GID=1001

# 机器人 QQ 号。设置后容器重启会自动快速登录，无需重新扫码
NAPCAT_ACCOUNT=10001

# ---------- LLM 配置 ----------
# LLM_API_KEY 必须从大模型平台申请，不是你随便编的密码。
# 留空则 llm_chat 插件静默跳过，不影响 /ping 等基础功能。
#
# 三个字段必须配套（换供应商要一起改）。常用组合：
#
#   DeepSeek 直连（默认，最便宜）
#     LLM_API_BASE=https://api.deepseek.com
#     LLM_MODEL=deepseek-flash          # 或 deepseek-v4-pro（旗舰，贵 10 倍）
#
#   阿里云百炼 / 通义千问（每模型 100 万 token 免费额度，90 天）
#     LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
#     LLM_MODEL=qwen3.6-flash
#
#   硅基流动（部分开源模型免费）
#     LLM_API_BASE=https://api.siliconflow.cn/v1
#     LLM_MODEL=deepseek-ai/DeepSeek-V3
#
#   智谱 GLM
#     LLM_API_BASE=https://open.bigmodel.cn/api/paas/v4
#     LLM_MODEL=glm-4.5-flash           # 有免费档
#
#   CommandCode（当前在用，聚合型：GPT / Claude / Gemini / Qwen / DeepSeek…）
#     LLM_API_BASE=https://api.commandcode.ai/provider/v1
#     LLM_MODEL=deepseek/deepseek-v4.1-flash
#     查看可用模型：curl $LLM_API_BASE/models -H "Authorization: Bearer $LLM_API_KEY"
#     ⚠️ Claude 系列只支持 /messages（Anthropic 格式），本插件用不了
#     ⚠️ 部分模型不在基础套餐内，会返回 MODEL_NOT_IN_PLAN
#
# 注意：DeepSeek 当前只提供 deepseek-flash 与 deepseek-v4-pro，
# 旧的 deepseek-chat 已失效。
LLM_API_BASE=https://api.commandcode.ai/provider/v1
LLM_API_KEY=
LLM_MODEL=deepseek/deepseek-v4.1-flash
LLM_COOLDOWN_SECONDS=5
LLM_MAX_HISTORY=6
LLM_MAX_CONCURRENCY=2

# 把「当前由哪个模型驱动」注入系统提示词。
# 模型本身并不知道自己跑在哪个模型上，关掉它被问到就会含糊其辞。
LLM_REVEAL_MODEL=true

# 把「今天是几号」注入系统提示词。
# 模型不知道当前日期，涉及「最新 / 今天」的回答会跑偏。
LLM_INJECT_DATE=true

# ---------- 读图（视觉输入） ----------
# 用户发图片时，机器人会下载图片转成 base64 喂给模型，模型直接看图回答。
# 需要模型支持视觉：当前主力模型 deepseek/deepseek-v4.1-flash 支持。
# ⚠️ 换成不支持视觉的模型时，请把这里设为 false，否则接口会报错。
LLM_VISION_ENABLED=true
# 单条消息最多处理几张图（每张都算视觉 token，别设太大）
LLM_MAX_IMAGES=2
# 单张图大小上限（字节）。base64 后还会膨胀约 1/3
LLM_MAX_IMAGE_BYTES=4000000

# ---------- 识图专用模型 / 接口（可选） ----------
# 文本对话和识图可以用不同的模型甚至不同的供应商。
#
# LLM_VISION_MODEL     留空则用 LLM_MODEL
# LLM_VISION_API_BASE  留空则用 LLM_API_BASE
# LLM_VISION_API_KEY   留空则用 LLM_API_KEY
#
# 典型用法：文本走 CommandCode，识图走阿里云百炼的免费额度。
#   百炼 OpenAI 兼容地址：https://dashscope.aliyuncs.com/compatible-mode/v1
#   百炼新人免费额度：每个模型独立 100 万 Token，90 天有效，仅华北2（北京）
LLM_VISION_MODEL=
LLM_VISION_API_BASE=
LLM_VISION_API_KEY=

# 「粘性图片」窗口（秒）。用户常把图片和问题分两条消息发，
# 这段时间内的纯文字消息会自动沿用最近那张图。
LLM_STICKY_IMAGE_SECONDS=120

# 调试：把收到的图片原样存到 data/bot/received/，排查识别率问题时才开
LLM_DEBUG_SAVE_IMAGES=false

# ---------- 酒馆（角色卡扮演） ----------
# QQ 里发送 /酒馆激活 [角色名] 进入角色扮演，/酒馆关闭 退出。
# 角色卡在管理台的「酒馆」标签页编辑，也支持导入 SillyTavern 的 JSON 卡。
LLM_TAVERN_CARDS_FILE=data/tavern_cards.json
LLM_TAVERN_STATE_FILE=data/tavern_state.json
# 角色扮演保留的历史条数。要连贯就得留长，但每条都在烧 token
LLM_TAVERN_MAX_HISTORY=20
# 扮演用的模型，留空则用 LLM_MODEL
LLM_TAVERN_MODEL=
# 扮演用的温度，通常比问答要高
LLM_TAVERN_TEMPERATURE=0.9

# ---------- 人格（persona） ----------
# 人格定义放在挂载卷里的 JSON 文件，改完即时生效，不用重建镜像：
#     ~/bot/data/bot/personas.json      （容器内是 /app/data/personas.json）
# 首次启动会自动生成 4 个示例人格：默认 / 猫娘 / 严谨助手 / 吐槽役。
#
# 条目格式：
#   {
#     "猫娘": {
#       "description": "/人格 列表里显示的说明",
#       "prompt": "系统提示词（必填）",
#       "temperature": 0.95,        // 可选，覆盖全局温度
#       "model": "..."              // 可选，覆盖全局模型
#     }
#   }
#
# 用法：/人格 查看列表与当前人格；/人格 猫娘 切换（会清空本会话上下文）
# 人格按会话独立：每个群、每个私聊互不影响，重启后仍保持。
LLM_PERSONA_FILE=data/personas.json
LLM_PERSONA_STATE_FILE=data/persona_state.json
LLM_PERSONA_DEFAULT=默认
# true = 群里任何人都能切换人格；false = 仅机器人管理员与群主/群管理员
LLM_PERSONA_OPEN=false

# ---------- 联网搜索 ----------
# 默认用 Bing，免费、无需任何 Key。开箱即用。
#
# 文字搜索走 cn.bing.com 的 RSS 输出（结构化 XML，不是脆弱的 HTML 抓取）；
# 图片搜索走 cn.bing.com/images，正则提取原图地址后直接发到聊天里。
SEARCH_ENABLED=true
# auto / bing / bocha
#   auto   有 BOCHA_API_KEY 就用博查，否则用免费的 Bing（默认）
#   bing   强制用 Bing，免费
#   bocha  强制用博查，中文搜索质量更好但按量计费
SEARCH_PROVIDER=auto

# 可选：博查 API Key（https://open.bocha.cn 注册，有免费额度）。
# 填了之后 auto 会自动切到博查，中文搜索质量比 Bing 好，且一次返回网页+图片。
# ⚠️ 注意：Bing 免费方案做的是字面词匹配，长句查询效果差，
#    所以工具的 description 里已要求模型先提取关键词。
BOCHA_API_KEY=

# 单次搜索返回的网页条数
SEARCH_COUNT=5
# 搜索请求超时（秒）
SEARCH_TIMEOUT=20.0
# 一次回复最多发送几张图片
SEARCH_MAX_IMAGES=1
# 工具调用最多循环几轮，防止模型反复搜索停不下来
SEARCH_MAX_ROUNDS=3

# ---------- Web 管理台 ----------
# 浏览器访问 http://127.0.0.1:18080/admin（通过 SSH 隧道，见 deploy/tunnel.bat）
# 能看运行状态、随时改人格、检查配置连贯性、看实时日志、一键重启。
#
# 留空则回落到 ONEBOT_ACCESS_TOKEN —— 但建议单独设一个，
# 免得一处泄露两处失守。生成：openssl rand -hex 24
WEBADMIN_TOKEN=

# ---------- 第三方插件（管理台的「插件商店」自动维护，通常不用手改） ----------
# 从插件商店安装的包放这里（挂载卷，重建容器不丢）
EXTRA_LIBS_DIR=data/pylibs
# 要加载的第三方插件模块名清单（JSON 数组）
EXTRA_PLUGINS_FILE=data/extra_plugins.json
